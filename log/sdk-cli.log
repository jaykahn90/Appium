    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        "    const APP_PKG = 'com.rolleaseacmeda.automatepulse'\n" +
        "    const CHROME_PKG = 'com.android.chrome'\n" +
        '\n' +
        '    // If Chrome is foreground, bring app back (safe guard)\n' +
        '    if ((await driver.getCurrentPackage()) === CHROME_PKG) {\n' +
        '      await driver.activateApp(APP_PKG)\n' +
        '      await browser.pause(1000)\n' +
        '    }\n' +
        '\n' +
        '    // ---------- WAIT FOR HOME TO SETTLE ----------\n' +
        '    const homeHeaderMarker = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.rightButton.button")',\n` +
        '    )\n' +
        '    await homeHeaderMarker.waitForDisplayed({\n' +
        '      timeout: 20000,\n' +
        "      timeoutMsg: 'Home header marker not visible after login',\n" +
        '    })\n' +
        '\n' +
        '    await browser.pause(7000)\n' +
        '\n' +
        '    // ---------- OPEN DRAWER (ONCE) ----------\n' +
        '    const hamburgerButton = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.menuButton.button")',\n` +
        '    )\n' +
        '    await hamburgerButton.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        "      timeoutMsg: 'Hamburger button not visible on main screen',\n" +
        '    })\n' +
        '    await hamburgerButton.click()\n' +
        '\n' +
        '    await browser.waitUntil(\n' +
        '      async () => {\n' +
        '        const supportCenterExists = await $(\n' +
        `          'android=new UiSelector().description("sidebar.supportCenterCard.button")',\n` +
        '        )\n' +
        '          .isDisplayed()\n' +
        '          .catch(() => false)\n' +
        '\n' +
        '        const knowledgeBaseExists = await $(\n' +
        `          'android=new UiSelector().description("sidebar.knowledgeBaseCard.button")',\n` +
        '        )\n' +
        '          .isDisplayed()\n' +
        '          .catch(() => false)\n' +
        '\n' +
        '        return supportCenterExists || knowledgeBaseExists\n' +
        '      },\n' +
        '      {\n' +
        '        timeout: 15000,\n' +
        '        interval: 400,\n' +
        "        timeoutMsg: 'Drawer opened but content not ready',\n" +
        '      },\n' +
        '    )\n' +
        '\n' +
        '    // ---------- OPEN SUPPORT CENTER ----------\n' +
        '    const supportCenterBtn = await $(\n' +
        "      'android=new UiScrollable(new UiSelector().scrollable(true))' +\n" +
        `        '.scrollIntoView(new UiSelector().description("sidebar.supportCenterCard.button"))',\n` +
        '    )\n' +
        '    await supportCenterBtn.waitForDisplayed({\n' +
        '      timeout: 10000,\n' +
        "      timeoutMsg: 'Support Center not visible in drawer',\n" +
        '    })\n' +
        '    await supportCenterBtn.click()\n' +
        '\n' +
        '    // ✅ WAIT FOR SUPPORT CENTER CONTENT TO FINISH RENDERING\n' +
        '    const supportChatBtn = await $(\n' +
        `      'android=new UiSelector().description("sidebar.supportChatCard.button")',\n` +
        '    )\n' +
        '    await supportChatBtn.waitForDisplayed({\n' +
        '      timeout: 10000,\n' +
        "      timeoutMsg: 'Support Center expanded but content not ready',\n" +
        '    })\n' +
        '\n' +
        '    // ---------- NOW SAFE TO ACCESS CONTACT SUPPORT ----------\n' +
        '    const contactSupportBtn = await $(\n' +
        `      'android=new UiSelector().description("sidebar.contactSupportCard.button")',\n` +
        '    )\n' +
        '    await contactSupportBtn.waitForDisplayed({\n' +
        '      timeout: 10000,\n' +
        "      timeoutMsg: 'Contact Support not visible after Support Center expanded',\n" +
        '    })\n' +
        '    await contactSupportBtn.click()\n' +
        '\n' +
        '    // ---------- ASSERT CONTACT SUPPORT SCREEN (IN-APP) ----------\n' +
        `    const heading = await $('android=new UiSelector().text("How can we help?")')\n` +
        '    await heading.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        `      timeoutMsg: '"How can we help?" not visible on Contact Support screen',\n` +
        '    })\n' +
        '    await expect(heading).toBeDisplayed()\n' +
        '\n' +
        '    const bodyText = await $(\n' +
        `      'android=new UiSelector().text("Whether you have questions about a product, need technical support or anything else, our team is ready to support you.")',\n` +
        '    )\n' +
        '    await bodyText.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        "      timeoutMsg: 'Expected description text not visible on Contact Support screen',\n" +
        '    })\n' +
        '    await expect(bodyText).toBeDisplayed()\n' +
        '\n' +
        '    // ---------- GO BACK TO HOME ----------\n' +
        '    const backBtn = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.backButton.button")',\n` +
        '    )\n' +
        '    await backBtn.waitForDisplayed({ timeout: 15000 })\n' +
        '    await backBtn.click()\n' +
        '\n' +
        '    // ---------- FINAL SANITY ----------\n' +
        '    const hamburgerAgain = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.menuButton.button")',\n` +
        '    )\n' +
        '    await hamburgerAgain.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        "      timeoutMsg: 'Returned to home but hamburger not visible',\n" +
        '    })\n' +
        '    await expect(hamburgerAgain).toBeDisplayed()\n' +
        '  }'
    },
