    body: {
      lang: 'ecmascript',
      code: 'async () => {\n' +
        "    await driver.switchContext('NATIVE_APP')\n" +
        '    await browser.pause(800)\n' +
        '\n' +
        '    // 1) Open sidebar menu\n' +
        '    const hamburgerButton = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.menuButton.button")',\n` +
        '    )\n' +
        '    await hamburgerButton.waitForDisplayed({ timeout: 10000 })\n' +
        '    await hamburgerButton.click()\n' +
        '\n' +
        '    // 2) Expand Support Center dropdown\n' +
        '    const supportCenterBtn = await $(\n' +
        `      'android=new UiSelector().description("sidebar.supportCenterCard.button")',\n` +
        '    )\n' +
        '    await supportCenterBtn.waitForDisplayed({ timeout: 10000 })\n' +
        '    await supportCenterBtn.click()\n' +
        '\n' +
        '    // 3) Assert dropdown options are visible\n' +
        '    const supportChat = await $(\n' +
        `      'android=new UiSelector().description("sidebar.supportChatCard.button")',\n` +
        '    )\n' +
        '    const contactSupport = await $(\n' +
        `      'android=new UiSelector().description("sidebar.contactSupportCard.button")',\n` +
        '    )\n' +
        '    const knowledgeBase = await $(\n' +
        `      'android=new UiSelector().description("sidebar.knowledgeBaseCard.button")',\n` +
        '    )\n' +
        '\n' +
        '    await expect(supportChat).toBeDisplayed()\n' +
        '    await expect(contactSupport).toBeDisplayed()\n' +
        '    await expect(knowledgeBase).toBeDisplayed()\n' +
        '  }'
    },
