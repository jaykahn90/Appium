        '    await contactSupportBtn.waitForDisplayed({\n' +
        '      timeout: 10000,\n' +
        "      timeoutMsg: 'Contact Support not visible after Support Center expanded',\n" +
        '    })\n' +
        '    await contactSupportBtn.click()\n' +
        '\n' +
        '    // ---------- ASSERT CONTACT SUPPORT SCREEN (IN-APP) ----------\n' +
        `    const heading = await $('android=new UiSelector().text("How can we help?")')\n` +
        '    await heading.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        `      timeoutMsg: '"How can we help?" not visible on Contact Support screen',\n` +
        '    })\n' +
        '    await expect(heading).toBeDisplayed()\n' +
        '\n' +
        '    const bodyText = await $(\n' +
        `      'android=new UiSelector().text("Whether you have questions about a product, need technical support or anything else, our team is ready to support you.")',\n` +
        '    )\n' +
        '    await bodyText.waitForDisplayed({\n' +
        '      timeout: 15000,\n' +
        "      timeoutMsg: 'Expected description text not visible on Contact Support screen',\n" +
        '    })\n' +
        '    await expect(bodyText).toBeDisplayed()\n' +
        '\n' +
        '    // ---------- GO BACK TO HOME ----------\n' +
        '    const backBtn = await $(\n' +
        `      'android=new UiSelector().description("sharedHeader.backButton.button")',\n` +
        '    )\n' +
        '    await backBtn.waitForDisplayed({ timeout: 15000 })\n' +
        '    await backBtn.click()\n' +
        '\n' +
        '    // ---------- FINAL SANITY ----------\n' +
