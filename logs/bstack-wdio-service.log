[90m2026-01-02T07:08:56.815Z[39m [32mDEBUG[39m [97m@wdio/browserstack-service[39m trackEvent: tracked instance data={"test_framework_name":"WebdriverIO-mocha","test_framework_version":"9.20.1","test_logs":[],"test_hooks_finished":{},"test_hooks_started":{},"test_uuid":"32ec3371-d38b-4106-a2c7-a050390203a1","test_result":"pending","test_hook_last_started":"TestFrameworkState.TEST","test_id":"Menu – Knowledge Base – Help – External URL links (Chrome) - opens both external help links in Chrome and validates URLs","test_name":"opens both external help links in Chrome and validates URLs","test_code":"async () => {\n    await ensureAppForeground()\n\n    await waitForHomeToSettle()\n    await openDrawer()\n    await openSupportCenter()\n    await openKnowledgeBase()\n    await openHubPairingAssist()\n    await scrollToBottomLinks()\n\n    // 1) Contact Local Support if Necessary -> Chrome -> assert contact URL -> back\n    const contactLink = await $(ui.contactLocalSupportLink)\n    await contactLink.waitForDisplayed({\n      timeout: 10000,\n      timeoutMsg: '\"Contact Local Support if Necessary\" not visible',\n    })\n    await contactLink.click()\n\n    await waitForChrome()\n    await acceptCookiesIfPresent()\n    await assertChromeUrlContains('automateshades.com/contact')\n    await returnToApp()\n\n    // Ensure we’re back on Hub Pairing Assist screen before next click\n    await $(ui.hubPairingAssistTitle).waitForDisplayed({ timeout: 15000 })\n    await scrollToBottomLinks()\n\n    // 2) More Info -> Chrome -> assert support URL -> back\n    const moreInfo = await $(ui.moreInfoLink)\n    await moreInfo.waitForDisplayed({\n      timeout: 10000,\n      timeoutMsg: '\"More Info\" not visible',\n    })\n    await moreInfo.click()\n\n    await waitForChrome()\n    await acceptCookiesIfPresent()\n    await assertChromeUrlContains('automateshades.com/support')\n    await assertChromeUrlContains('hub-pairing-assistant')\n    await returnToApp()\n  }","test_file_path":"test/specs/android/menu/KnowledgeBase-Help-URL-Links.spec.js","test_location":"test/specs/android/menu/KnowledgeBase-Help-URL-Links.spec.js","test_scope":"Menu – Knowledge Base – Help – External URL links (Chrome) - opens both external help links in Chrome and validates URLs","test_scopes":["Menu – Knowledge Base – Help – External URL links (Chrome)"],"test_started_at":"2026-01-02T07:08:56.814Z"}
